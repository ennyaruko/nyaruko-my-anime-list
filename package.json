{
  "name": "my-anime-list",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "homepage": "https://nyar1othotep.github.io/my-anime-list/",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router typegen && tsc -b && react-router build",
    "postbuild": "node scripts/prepare-github-pages.mjs",
    "prepare": "husky",
    "commitlint": "commitlint",
    "preview": "vite preview",
    "typecheck": "react-router typegen && tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "steiger": "steiger ./src",
    "steiger:fix": "steiger ./src --fix",
    "graphql:codegen": "graphql-codegen --config codegen.ts",
    "graphql:codegen:watch": "graphql-codegen --config codegen.ts --watch",
    "locales:lint": "i18next-cli lint",
    "locales:check": "i18next-cli status",
    "locales:unused": "i18next-cli status --unused",
    "locales:remove": "i18next-cli extract",
    "test": "vitest run",
    "test:watch": "vitest",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build/client"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@tanstack/query-async-storage-persister": "^5.104.3",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-query-persist-client": "^5.104.3",
    "@vanilla-extract/css": "^1.17.4",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "graphql": "^16.14.2",
    "graphql-request": "^7.4.0",
    "i18next": "^26.4.7",
    "i18next-browser-languagedetector": "^8.2.1",
    "idb-keyval": "^6.3.0",
    "isbot": "^5",
    "radix-ui": "1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.6",
    "react-hook-form": "^7.90.0",
    "react-i18next": "^17.0.20",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "react-simple-pull-to-refresh": "^1.3.4",
    "react-toastify": "^11.1.0",
    "react-virtuoso": "^4.18.19",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.5",
    "@feature-sliced/steiger-plugin": "^0.8.0",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/client-preset": "^6.2.3",
    "@react-router/dev": "^8.4.0",
    "@react-router/node": "^8.4.0",
    "@svgr/rollup": "^8.1.0",
    "@types/node": "^24.7.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-react-hooks": "^6.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "gh-pages": "^6.3.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "i18next-cli": "^1.80.4",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "steiger": "^0.7.0",
    "tsx": "^4.20.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  }
}
